<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BattleLauncher</AssemblyName>
    <RootNamespace>BattleLauncher</RootNamespace>
    <!-- Версию поднимать при каждом изменении: по ней лаунчер понимает, что вышло обновление -->
    <Version>1.47.2</Version>
    <Product>Ghost Shell Launcher</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Лаунчер Тролль-Баттл: вход в аккаунт, установка и обновление приложений проекта</Description>
    <AssemblyTitle>Ghost Shell Launcher</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
    <Compile Include="..\Shared\ChamferBorder.cs" Link="ChamferBorder.cs"/>
  </ItemGroup>

  <ItemGroup>
    <!-- языки интерфейса (русский / English / Deutsch): общий модуль и словари -->
    <Compile Include="..\Shared\Loc.cs" Link="Loc.cs"/>
    <EmbeddedResource Include="..\Shared\Loc\common.loc" LogicalName="loc/common.loc"/>
    <EmbeddedResource Include="Loc\app.loc" LogicalName="loc/app.loc"/>
  </ItemGroup>

</Project>
