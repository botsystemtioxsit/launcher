<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BattleLauncher</AssemblyName>
    <RootNamespace>BattleLauncher</RootNamespace>
    <!-- Версию поднимать при каждом изменении: по ней лаунчер понимает, что вышло обновление -->
    <Version>1.22.0</Version>
    <Product>Ghost Shell Launcher</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Лаунчер Тролль-Баттл: вход в аккаунт, установка и обновление приложений проекта</Description>
    <AssemblyTitle>Ghost Shell Launcher</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
