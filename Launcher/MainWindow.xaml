<Window x:Class="BattleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="БАТТЛ Лаунчер" Width="980" Height="680" MinWidth="760" MinHeight="520"
        Background="{StaticResource Bg}" Icon="Assets/icon.ico"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Плашка «вышла новая версия лаунчера» -->
    <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource Accent}" Padding="14,7">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="UpdateText" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="UpdateBtn" Content="Обновить сейчас" Margin="14,0,0,0" Padding="12,4" Click="UpdateBtn_Click"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- Вход -->
      <Grid x:Name="LoginView" Visibility="Collapsed">
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="24">
          <StackPanel>
            <Image Source="Assets/icon.ico" Width="64" Height="64" HorizontalAlignment="Center"/>
            <TextBlock Text="БАТТЛ Лаунчер" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,0,14"
                       Text="Войди в свой аккаунт — тот же, что в игре. Почта должна быть привязана в игре: Настройки → Аккаунт."/>
            <StackPanel x:Name="SavedAccounts" Margin="0,0,0,12"/>
            <TextBlock Text="Email аккаунта" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,10" KeyDown="EmailBox_KeyDown"/>
            <Button x:Name="LoginBtn" Content="Запросить вход" Style="{StaticResource Primary}" Click="LoginBtn_Click"/>
            <Button x:Name="LoginCancelBtn" Content="Отменить" Style="{StaticResource Ghost}" Margin="0,8,0,0" Visibility="Collapsed" Click="LoginCancelBtn_Click"/>
            <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,12,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{StaticResource Red}" Margin="0,12,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Основное окно -->
      <Grid x:Name="MainView" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,18">
          <DockPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0"/>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="6,0,0,20">
                <Image Source="Assets/icon.ico" Width="30" Height="30"/>
                <TextBlock Text="БАТТЛ" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
              <Button x:Name="NavApps" Content="Приложения" Style="{StaticResource Nav}" Click="NavApps_Click"/>
              <Button x:Name="NavAccount" Content="Аккаунт" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavAccount_Click"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,26">
          <!-- Приложения -->
          <DockPanel x:Name="AppsView">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
              <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Проверить обновления" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="RefreshBtn_Click"/>
              <StackPanel>
                <TextBlock Text="Приложения" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="AppsSub" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="AppList"/>
            </ScrollViewer>
          </DockPanel>

          <!-- Аккаунт -->
          <StackPanel x:Name="AccountView" Visibility="Collapsed">
            <TextBlock Text="Аккаунт" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Можно держать несколько аккаунтов и переключаться между ними." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="22">
              <StackPanel x:Name="MeBox" Orientation="Horizontal"/>
            </Border>
            <TextBlock Text="Все аккаунты" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,22,0,10"/>
            <StackPanel x:Name="AllAccounts"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="+ Добавить аккаунт" Style="{StaticResource Ghost}" Click="AddAccount_Click"/>
              <Button Content="Выйти" Style="{StaticResource Danger}" Margin="10,0,0,0" Click="Logout_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed"
              Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,10" MaxWidth="600">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
      </Border>
    </Grid>
  </Grid>
</Window>
