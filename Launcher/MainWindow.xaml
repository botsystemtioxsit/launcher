<Window x:Class="BattleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost Shell Launcher" Width="980" Height="680" MinWidth="760" MinHeight="520"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Плашка «вышла новая версия лаунчера» -->
    <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed" Background="#17130A" BorderBrush="{DynamicResource Yellow}" BorderThickness="0,0,0,1" Padding="14,8">
      <Border.Effect><DropShadowEffect Color="#FCEE0A" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="▲" Foreground="{DynamicResource Yellow}" FontFamily="{StaticResource Mono}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="UpdateText" Foreground="{DynamicResource Yellow}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="UpdateBtn" Content="Обновить сейчас" Style="{StaticResource Warn}" Margin="16,0,0,0" Padding="14,5" Click="UpdateBtn_Click"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- Основное окно -->
      <Grid x:Name="MainView">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12,18">
          <DockPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,0,0,0"/>
            <StackPanel x:Name="LangRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,12"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
              <Button x:Name="OpsToggleBtn" Content="☰ Очередь" Style="{StaticResource Ghost}" Margin="0,0,0,6" Click="OpsToggleBtn_Click" ToolTip="Что сейчас обновляется, что стоит в очереди и чем всё закончилось"/>
              <Button x:Name="BulkUpdateBtn" Content="⟳ Обновить всё" Style="{StaticResource Ghost}" Click="BulkUpdateBtn_Click" ToolTip="Обновить все приложения, плагины и расширения, у которых вышла новая версия"/>
              <Button x:Name="BulkLaunchBtn" Content="▶ Запустить всё" Style="{StaticResource Ghost}" Margin="0,6,0,0" Click="BulkLaunchBtn_Click" ToolTip="Запустить все установленные приложения и плагины, которые сейчас не работают"/>
            </StackPanel>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="6,0,0,20">
                
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="GHOST SHELL" FontFamily="{StaticResource Mono}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="создано нейросетью" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Accent2}"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="NavApps" Content="Приложения" Style="{StaticResource Nav}" Click="NavApps_Click"/>
              <Button x:Name="NavStyle" Content="Оформление" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavStyle_Click"/>
              <Button x:Name="NavNet" Content="Сеть и защита" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavNet_Click"/>
              <Button x:Name="NavExt" Content="Расширения" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavExt_Click"/>
              <Button x:Name="NavEnv" Content="Окружение" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavEnv_Click"/>
              <Button x:Name="NavFeedback" Content="Написать нам" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavFeedback_Click"/>
              <Button x:Name="NavAccount" Content="Аккаунт" Style="{StaticResource Nav}" Margin="0,2,0,0" Click="NavAccount_Click"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">
         <Grid.RowDefinitions>
           <RowDefinition Height="*"/>
           <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="30,26">
              <!-- Вход: нужен только для приложений администраторов, живёт во вкладке «Аккаунт» -->
          <ScrollViewer x:Name="LoginView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Width="440" Margin="0,24" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="24">
              <StackPanel>
            
                <TextBlock Text="GHOST SHELL" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock.Effect><DropShadowEffect Color="#00F0FF" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="LAUNCHER · создано нейросетью" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Accent2}" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"
                           Text="Вход нужен только администраторам: он открывает вкладку «Приложения». Плагины работают и без входа."/>
                <!-- Что сейчас происходит: сразу под заголовком, чтобы было видно, что запрос отправлен и идёт ожидание -->
                <Border x:Name="LoginBusyBox" Visibility="Collapsed" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,0,0,14">
                  <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10"/>
                    <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="LoginCountdown" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                    <Button x:Name="LoginCancelBtn" Content="Отменить" Style="{StaticResource Ghost}" Margin="0,10,0,0" Click="LoginCancelBtn_Click"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{DynamicResource Red}" Margin="0,0,0,12" Visibility="Collapsed"/>
                <StackPanel x:Name="SavedAccounts" Margin="0,0,0,12"/>

                <!-- 1. Заявка по почте -->
                <TextBlock Text="По почте" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBlock Text="Почта должна быть привязана в игре (Настройки → Аккаунт). Заявку подтвердишь сам, без пароля." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                <TextBox x:Name="EmailBox" Margin="0,0,0,10" KeyDown="EmailBox_KeyDown"/>
                <Button x:Name="LoginBtn" Content="Запросить вход" Style="{StaticResource Primary}" Click="LoginBtn_Click"/>

                <!-- 2. Токен доступа -->
                <TextBlock Text="— или —" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <TextBlock Text="По токену доступа" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="Токен выдаёт Супердоступ. Входит сразу, без заявки и без аккаунта; открывает только админ-панель." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                <TextBox x:Name="TokenBox" Margin="0,0,0,10" KeyDown="TokenBox_KeyDown"/>
                <Button x:Name="TokenBtn" Content="Войти по токену" Click="TokenBtn_Click"/>

                <!-- 3. Код устройства -->
                <TextBlock Text="— или —" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <TextBlock Text="По коду устройства (через бота)" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"
                           Text="Без почты. Нажми кнопку — появится код. Открой в Telegram бота TerminalBot и отправь ему этот код обычным сообщением — лаунчер сразу войдёт в твой аккаунт. Устройство можно отозвать в админ-панели («Аккаунт»)."/>
                <Button x:Name="PairBtn" Content="Подключить по коду" Click="PairBtn_Click"/>
                <TextBlock x:Name="PairCode" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>

              </StackPanel>
            </Border>
          </ScrollViewer>

          <!-- Приложения -->
          <DockPanel x:Name="AppsView">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
              <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="470">
                <Button x:Name="AppsUpdateAllBtn" Content="Обновить все" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="AppsUpdateAll_Click"/>
                <Button x:Name="AppsLaunchAllBtn" Content="Запустить все" Style="{StaticResource Ghost}" Margin="8,0,0,6" Click="AppsLaunchAll_Click"/>
                <Button x:Name="RefreshBtn" Content="Проверить обновления" Style="{StaticResource Ghost}" Margin="8,0,0,6" Click="RefreshBtn_Click"/>
              </WrapPanel>
              <StackPanel>
                <TextBlock Text="Приложения" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="AppsSub" Foreground="{DynamicResource Muted}" Margin="0,4,16,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="AppList"/>
            </ScrollViewer>
          </DockPanel>

          <!-- Плагины: «Оформление», «Сеть и защита» и «Расширения» — один и тот же вид, разный список (см. SetPluginsView) -->
          <DockPanel x:Name="PluginsView" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
              <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="380">
                <Button x:Name="PluginsUpdateAllBtn" Content="Обновить все" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="PluginsUpdateAll_Click"/>
                <Button x:Name="PluginsLaunchAllBtn" Content="Запустить все" Style="{StaticResource Ghost}" Margin="8,0,0,6" Click="PluginsLaunchAll_Click"/>
              </WrapPanel>
              <StackPanel>
                <TextBlock x:Name="PluginsTitle" Text="Оформление" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="PluginsHint" Foreground="{DynamicResource Muted}" Margin="0,4,16,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel x:Name="PluginList"/>
                <StackPanel x:Name="BrowserPluginList" Visibility="Collapsed"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Окружение: автозапуск и набор плагинов (содержимое строится в MainWindow.Environment.cs) -->
          <ScrollViewer x:Name="EnvView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EnvBody"/>
          </ScrollViewer>

          <!-- Написать нам: ошибки и предложения владельцу (содержимое строится в MainWindow.Feedback.cs) -->
          <ScrollViewer x:Name="FeedbackView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FeedbackBody"/>
          </ScrollViewer>

          <!-- Аккаунт -->
          <StackPanel x:Name="AccountView" Visibility="Collapsed">
            <TextBlock Text="Аккаунт" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Можно держать несколько аккаунтов и переключаться между ними." Foreground="{DynamicResource Muted}" Margin="0,4,0,18"/>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="22">
              <StackPanel x:Name="MeBox" Orientation="Horizontal"/>
            </Border>
            <TextBlock Text="Все аккаунты" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="0,22,0,10"/>
            <StackPanel x:Name="AllAccounts"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="+ Добавить аккаунт" Style="{StaticResource Ghost}" Click="AddAccount_Click"/>
              <Button Content="Выйти" Style="{StaticResource Danger}" Margin="10,0,0,0" Click="Logout_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Менеджер обновлений: что в очереди, что идёт сейчас, чем закончилось (содержимое — MainWindow.Ops.cs) -->
        <Border x:Name="OpsDock" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,1,0,0" Padding="22,12,22,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="OpsSummary" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
                <TextBlock x:Name="OpsNow" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <ProgressBar x:Name="OpsProgress" Width="NaN" HorizontalAlignment="Stretch" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="330">
                <Button x:Name="OpsExpandBtn" Content="▾ Свернуть" Style="{StaticResource Ghost}" Padding="10,4" FontSize="12" Margin="0,0,0,4" Click="OpsExpandBtn_Click"/>
                <Button x:Name="OpsCancelBtn" Content="Отменить очередь" Style="{StaticResource Ghost}" Padding="10,4" FontSize="12" Margin="6,0,0,4" Click="OpsCancelBtn_Click"/>
                <Button x:Name="OpsClearBtn" Content="Закрыть" Style="{StaticResource Ghost}" Padding="10,4" FontSize="12" Margin="6,0,0,4" Click="OpsClearBtn_Click"/>
              </WrapPanel>
            </Grid>
            <ScrollViewer x:Name="OpsListScroll" MaxHeight="230" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="OpsList"/>
            </ScrollViewer>
          </StackPanel>
        </Border>
        </Grid>
      </Grid>

      <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed"
              Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="18,10" MaxWidth="600">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
      </Border>
    </Grid>
  </Grid>
</Window>
