<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TIOXSITTerminal</AssemblyName>
    <RootNamespace>TioxsitTerminal</RootNamespace>
    <ApplicationIcon>..\Launcher\Assets\icon.ico</ApplicationIcon>
    <!-- Версию поднимать при каждом изменении -->
    <Version>0.4.0</Version>
    <Product>Ghost Shell Terminal</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Ghost Shell Terminal — та же админ-панель проекта Тролль-Баттл в виде Windows-приложения</Description>
    <AssemblyTitle>Ghost Shell Terminal</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Общий с лаунчером код: сеть, база, аккаунты (тот же файл сессии, поэтому вход из лаунчера работает и здесь) -->
    <Compile Include="..\Launcher\Services\Net.cs" Link="Shared\Net.cs" />
    <Compile Include="..\Launcher\Services\Rtdb.cs" Link="Shared\Rtdb.cs" />
    <Compile Include="..\Launcher\Services\AccountStore.cs" Link="Shared\AccountStore.cs" />
    <Compile Include="..\Launcher\Services\Catalog.cs" Link="Shared\Catalog.cs" />
    <Resource Include="..\Launcher\Assets\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

</Project>
