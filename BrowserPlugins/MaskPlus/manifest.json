{
  "manifest_version": 3,
  "name": "Mask Plus",
  "version": "1.2.0",
  "description": "__MSG_desc__",
  "default_locale": "ru",
  "author": "TIOXSIT",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mask Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
