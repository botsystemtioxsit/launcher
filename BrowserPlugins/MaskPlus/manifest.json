{
  "manifest_version": 3,
  "name": "Mask Plus",
  "version": "1.1.0",
  "description": "Маскирует часовой пояс, язык и местоположение браузера под выбранную страну, по желанию подменяет систему и браузер. IP-адрес не меняет. Создано нейросетью. Ghost Shell.",
  "author": "TIOXSIT",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "declarativeNetRequest", "privacy"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Mask Plus",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
