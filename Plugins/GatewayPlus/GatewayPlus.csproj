<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GatewayPlus</AssemblyName>
    <RootNamespace>GatewayPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>3.2.0</Version>
    <Product>Gateway Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Gateway Plus — личный VPN: мастер ставит WireGuard или свой протокол GSP на ваш сервер по SSH, а шлюз пускает через него весь интернет компьютера (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Gateway Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <EmbeddedResource Include="Resources\server-setup.sh" LogicalName="server-setup.sh" />
    <EmbeddedResource Include="Resources\add-device.sh" LogicalName="add-device.sh" />
    <EmbeddedResource Include="Resources\tune-server.sh" LogicalName="tune-server.sh" />
    <EmbeddedResource Include="Resources\gsp-server-setup.sh" LogicalName="gsp-server-setup.sh" />
    <!-- программа GSP и сетевая карта wintun вкладываются в плагин сборкой в CI (Resources\bin\ не хранится в git) -->
    <EmbeddedResource Include="Resources\bin\gsp.exe" LogicalName="gsp.exe" Condition="Exists('Resources\bin\gsp.exe')" />
    <EmbeddedResource Include="Resources\bin\wintun.dll" LogicalName="wintun.dll" Condition="Exists('Resources\bin\wintun.dll')" />
  </ItemGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <!-- языки интерфейса (русский / English / Deutsch): общий модуль и словари -->
    <Compile Include="..\..\Shared\Loc.cs" Link="Loc.cs"/>
    <EmbeddedResource Include="..\..\Shared\Loc\common.loc" LogicalName="loc/common.loc"/>
    <EmbeddedResource Include="Loc\app.loc" LogicalName="loc/app.loc"/>
  </ItemGroup>

</Project>
