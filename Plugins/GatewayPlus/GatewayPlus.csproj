<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GatewayPlus</AssemblyName>
    <RootNamespace>GatewayPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>1.0.0</Version>
    <Product>Gateway Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Gateway Plus — шлюз: весь интернет с компьютера идёт через свой сервер (WireGuard), сайты видят его адрес и страну (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Gateway Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="Resources\server-setup.sh" LogicalName="server-setup.sh" />
  </ItemGroup>

</Project>
