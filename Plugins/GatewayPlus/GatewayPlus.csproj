<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GatewayPlus</AssemblyName>
    <RootNamespace>GatewayPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>2.5.0</Version>
    <Product>Gateway Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Gateway Plus — личный VPN: мастер ставит WireGuard на ваш сервер по SSH, а шлюз пускает через него весь интернет компьютера (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Gateway Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <EmbeddedResource Include="Resources\server-setup.sh" LogicalName="server-setup.sh" />
    <EmbeddedResource Include="Resources\add-device.sh" LogicalName="add-device.sh" />
    <EmbeddedResource Include="Resources\tune-server.sh" LogicalName="tune-server.sh" />
  </ItemGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
  </ItemGroup>

</Project>
