<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IconPlus</AssemblyName>
    <RootNamespace>IconPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>1.5.0</Version>
    <Product>Icon Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Icon Plus — значки Windows по-своему: один цвет для всех значков или готовые наборы иконок (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Icon Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 7z и rar из скачанных наборов (лицензия MIT); встроенный браузер для сайта с иконками (Microsoft WebView2) -->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <!-- языки интерфейса (русский / English / Deutsch): общий модуль и словари -->
    <Compile Include="..\..\Shared\Loc.cs" Link="Loc.cs"/>
    <EmbeddedResource Include="..\..\Shared\Loc\common.loc" LogicalName="loc/common.loc"/>
    <EmbeddedResource Include="Loc\app.loc" LogicalName="loc/app.loc"/>
  </ItemGroup>

</Project>
