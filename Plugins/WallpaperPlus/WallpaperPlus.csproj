<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WallpaperPlus</AssemblyName>
    <RootNamespace>WallpaperPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>1.3.0</Version>
    <Product>Wallpaper Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Wallpaper Plus — живые обои для рабочего стола Windows: готовые, из каталога, из файла, с сайтов (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Wallpaper Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- движок страниц и видео для обоев и встроенный браузер сайтов (Microsoft Edge WebView2) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- уровень и спектр звука системы для «Терминала» (MIT) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- встроенные обои: страницы (HTML) внутри программы, при первом запуске раскладываются в библиотеку -->
    <EmbeddedResource Include="Wallpapers\**\*.*" LogicalName="wp/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- служебные файлы для страниц обоев: gs.js (данные компьютера) и compose.html (фон + слой поверх) -->
    <EmbeddedResource Include="Resources\*.*" LogicalName="res/%(Filename)%(Extension)" />
  </ItemGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <!-- языки интерфейса (русский / English / Deutsch): общий модуль и словари -->
    <Compile Include="..\..\Shared\Loc.cs" Link="Loc.cs"/>
    <EmbeddedResource Include="..\..\Shared\Loc\common.loc" LogicalName="loc/common.loc"/>
    <EmbeddedResource Include="Loc\app.loc" LogicalName="loc/app.loc"/>
  </ItemGroup>

</Project>
