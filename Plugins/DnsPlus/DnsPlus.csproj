<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DnsPlus</AssemblyName>
    <RootNamespace>DnsPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>1.1.0</Version>
    <Product>DNS Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>DNS Plus — защищённый DNS (NextDNS) для всей Windows: вставьте свой ID и нажмите «Включить» (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>DNS Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <!-- общий киберпанк-стиль (Shared/CyberTheme.xaml), один на все приложения -->
    <Page Include="..\..\Shared\CyberTheme.xaml" Link="CyberTheme.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <!-- языки интерфейса (русский / English / Deutsch): общий модуль и словари -->
    <Compile Include="..\..\Shared\Loc.cs" Link="Loc.cs"/>
    <EmbeddedResource Include="..\..\Shared\Loc\common.loc" LogicalName="loc/common.loc"/>
    <EmbeddedResource Include="Loc\app.loc" LogicalName="loc/app.loc"/>
  </ItemGroup>

</Project>
