<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarPlus</AssemblyName>
    <RootNamespace>TaskbarPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>1.4.5</Version>
    <Product>Taskbar Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Taskbar Plus — панель задач Windows по-своему (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Taskbar Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Движок для Windows 11 (папка Engine, C++) собирается на GitHub Actions и вкладывается в EXE плагина -->
  <ItemGroup Condition="Exists('Engine/out/GhostShellTap.dll')">
    <EmbeddedResource Include="Engine/out/GhostShellTap.dll" LogicalName="GhostShellTap.dll" />
  </ItemGroup>

</Project>
