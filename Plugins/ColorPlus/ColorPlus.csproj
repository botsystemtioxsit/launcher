<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ColorPlus</AssemblyName>
    <RootNamespace>ColorPlusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию поднимать при каждом изменении -->
    <Version>2.1.0</Version>
    <Product>Color Plus</Product>
    <Company>TIOXSIT</Company>
    <Authors>TIOXSIT</Authors>
    <Copyright>TIOXSIT</Copyright>
    <Description>Color Plus — один цвет для окон, выделения и панели задач с предпросмотром (плагин Ghost Shell Launcher)</Description>
    <AssemblyTitle>Color Plus</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
